{
  "hosting": [
    {
      "target": "front",
      "public": "dist/apps/front/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "dashboard",
      "public": "dist/apps/dashboard",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/dashboard/**",
          "destination": "/browser/index.html"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/functions/**",
      "function": "api"
    }
  ]
}
