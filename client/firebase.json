{
  "hosting": [
    {
      "site": "dashboard-dedicated-ip-production",
      "public": "dist/apps/dashboard/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "site": "dedicated-ip-production",
      "public": "dist/apps/front/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    }
  ],
  "rewrites": [
    {
      "site": "dedicated-ip-production",
      "source": "/functions/**",
      "function": "api"
    }
  ]
}
