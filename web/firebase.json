{
  "hosting": [
    {
      "site": "dashboard-dedicated-ip-production",
      "public": "dist/apps/dashboard/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "functions-dedicated-ip-production",
      "rewrites": [
        {
          "site": "functions-dedicated-ip-production",
          "source": "**",
          "function": "onHttpWebhook"
        }
      ]
    },
    {
      "site": "payment-webhook-dedicated-ip-production",
      "rewrites": [
        {
          "site": "payment-webhook-dedicated-ip-production",
          "source": "**",
          "function": "onPaymentWebhook"
        }
      ]
    }
  ]
}
